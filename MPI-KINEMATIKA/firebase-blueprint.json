        "accountId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Student app account ID."
        },
        "npsn": {
          "type": "string",
          "minLength": 4,
          "maxLength": 20,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "School NPSN identifier."
        },
        "studentUid": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Firebase Auth UID of the student."
        },
        "studentName": {
          "type": "string",
          "maxLength": 120,
          "description": "Student display name."
        },
        "className": {
          "type": "string",
          "maxLength": 60,
          "description": "Student class."
        },
        "schoolName": {
          "type": "string",
          "maxLength": 150,
          "description": "School name."
        },
        "allowedTeacherUids": {
          "type": "array",
          "description": "Bounded list of up to 10 teacher UIDs."
        },
        "xp": {
          "type": "number",
