      },
      "required": [
        "id",
        "npsn",
        "studentUid",
        "studentAccountId",
        "studentName",
        "className",
        "allowedTeacherUids",
        "date",
        "ratingGLB",
        "ratingGLBB",
        "ratingGraph",
        "ratingLab",
        "mood",
        "interestingThing",
        "challengingThing",
        "labExperience",
        "nextTarget",
        "submittedAt",
