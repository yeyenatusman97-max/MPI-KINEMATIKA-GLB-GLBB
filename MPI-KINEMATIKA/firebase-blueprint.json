          "description": "Creation server timestamp."
        }
      },
      "required": [
        "id",
        "npsn",
        "studentUid",
        "studentAccountId",
        "studentName",
        "className",
        "allowedTeacherUids",
        "score",
        "totalQuestions",
        "timeSpentSeconds",
        "category",
        "submittedAt",
        "createdAt"
      ]
    },
    "StudentReport": {
      "title": "StudentReport",
