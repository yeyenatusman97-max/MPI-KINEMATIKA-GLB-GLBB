    "LoginLookup": {
      "title": "LoginLookup",
      "description": "Keyed SHA-256 directory storing AES-256-GCM password-encrypted auth email for email-less cross-device login without exposing plaintext PII.",
      "type": "object",
      "properties": {
        "lookupId": {
          "type": "string",
          "minLength": 64,
          "maxLength": 64,
          "pattern": "^[a-f0-9]+$",
          "description": "SHA-256 digest of role, normalized name, and class."
        },
        "uid": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Owner Firebase Auth UID."
        },
        "role": {
          "type": "string",
          "enum": ["guru", "murid"],
          "description": "Immutable account role."
        },
        "cipherEmail": {
          "type": "string",
          "minLength": 16,
          "maxLength": 512,
          "description": "Base64 AES-256-GCM ciphertext of auth email encrypted with user password."
        },
        "iv": {
          "type": "string",
          "minLength": 8,
          "maxLength": 64,
          "description": "Base64 AES-GCM initialization vector."
        },
        "salt": {
          "type": "string",
          "minLength": 8,
          "maxLength": 64,
          "description": "Base64 PBKDF2 salt."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Creation server timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Last update server timestamp."
        }
      },
      "required": ["lookupId", "uid", "role", "cipherEmail", "iv", "salt", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Private user role and NPSN profile owned strictly by the signed-in user."
    },
    "/schools/{npsn}": {
      "schema": { "$ref": "#/entities/School" },
      "description": "School workspace keyed by NPSN."
    },
    "/schools/{npsn}/members/{memberId}": {
      "schema": { "$ref": "#/entities/SchoolMember" },
      "description": "Verified teacher and student members inside a school."
    },
    "/schools/{npsn}/lkpdSubmissions/{submissionId}": {
      "schema": { "$ref": "#/entities/LKPDSubmission" },
      "description": "Student LKPD submissions and teacher feedback for the school."
    },
    "/schools/{npsn}/quizResults/{resultId}": {
      "schema": { "$ref": "#/entities/QuizSubmission" },
      "description": "Student quiz attempts synced to teachers in the school."
    },
    "/schools/{npsn}/studentReports/{accountId}": {
      "schema": { "$ref": "#/entities/StudentReport" },
      "description": "Student report cards synced automatically to the teacher dashboard."
    },
    "/schools/{npsn}/reflections/{reflectionId}": {
      "schema": { "$ref": "#/entities/StudentReflection" },
      "description": "Student reflections collected from student accounts and synced to teacher's Hasil Refleksi Murid."
    },
    "/loginLookup/{lookupId}": {
      "schema": { "$ref": "#/entities/LoginLookup" },
      "description": "Exact-key password-encrypted login lookup (no list access, no plaintext PII)."
    }
  }
}
