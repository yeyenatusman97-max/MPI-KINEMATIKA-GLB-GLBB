      "title": "StudentReflection",
      "description": "Student learning reflection submitted from student account and synced to the teacher's Hasil Refleksi Murid view.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Reflection document ID."
        },
        "npsn": {
          "type": "string",
          "minLength": 4,
          "maxLength": 20,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "School NPSN identifier."
        },
        "studentUid": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Firebase Auth UID of the student."
        },
        "studentAccountId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Student app account ID."
        },
        "studentName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "description": "Student display name."
        },
        "className": {
          "type": "string",
          "maxLength": 60,
          "description": "Student class."
        },
        "allowedTeacherUids": {
          "type": "array",
          "description": "Bounded list of up to 10 teacher UIDs."
        },
        "date": {
