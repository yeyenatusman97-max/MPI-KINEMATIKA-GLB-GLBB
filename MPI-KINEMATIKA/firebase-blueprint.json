        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Creation server timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Last update server timestamp."
        }
      },
      "required": [
        "accountId",
        "npsn",
        "studentUid",
        "studentName",
        "className",
        "schoolName",
        "allowedTeacherUids",
        "xp",
        "level",
        "lastQuizScore",
        "experimentsCount",
        "lkpdSubmittedCount",
        "badges",
        "status",
        "createdAt",
        "updatedAt"
      ]
    },
