{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Private user role and school NPSN binding for authenticated user.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Firebase Auth UID of the user."
        },
        "role": {
          "type": "string",
          "enum": ["guru", "murid"],
          "description": "Assigned role in the learning platform."
        },
        "npsn": {
          "type": "string",
          "minLength": 4,
          "maxLength": 20,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "School NPSN identifier."
        },
        "accountId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Deterministic app account ID."
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "description": "Teacher name or student display name."
        },
        "className": {
          "type": "string",
          "maxLength": 60,
          "description": "Student grade/class name."
        },
        "email": {
          "type": "string",
          "maxLength": 160,
          "description": "User authentication email stored strictly in private owner-only profile."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Creation server timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Last update server timestamp."
        }
      },
      "required": ["uid", "role", "npsn", "accountId", "displayName", "className", "createdAt", "updatedAt"]
    },
    "School": {
      "title": "School",
      "description": "School container indexed by NPSN linking teacher and student workspaces.",
      "type": "object",
      "properties": {
        "npsn": {
          "type": "string",
          "minLength": 4,
          "maxLength": 20,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "School NPSN identifier."
        },
        "schoolName": {
          "type": "string",
          "maxLength": 150,
          "description": "Name of the school."
        },
        "ownerUid": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "UID of the creator."
        },
        "teacherUids": {
          "type": "array",
          "description": "Bounded list of up to 10 verified teacher UIDs for this school."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Creation server timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Last update server timestamp."
        }
      },
      "required": ["npsn", "schoolName", "ownerUid", "teacherUids", "createdAt", "updatedAt"]
    },
    "SchoolMember": {
      "title": "SchoolMember",
      "description": "Verified membership record inside a school keyed by member UID.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Firebase Auth UID of the member."
        },
        "npsn": {
          "type": "string",
          "minLength": 4,
          "maxLength": 20,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "School NPSN identifier."
        },
        "role": {
          "type": "string",
          "enum": ["guru", "murid"],
          "description": "Role of this member within the school."
        },
        "accountId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "App-level account ID."
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "description": "Display name."
        },
        "className": {
          "type": "string",
          "maxLength": 60,
          "description": "Student class level."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Creation server timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Last update server timestamp."
        }
      },
      "required": ["uid", "npsn", "role", "accountId", "displayName", "className", "createdAt", "updatedAt"]
    },
    "LKPDSubmission": {
      "title": "LKPDSubmission",
      "description": "Student-submitted LKPD experiment data, answers, and two-way teacher feedback.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Submission document ID."
        },
        "npsn": {
          "type": "string",
          "minLength": 4,
          "maxLength": 20,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "School NPSN identifier."
        },
        "studentUid": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Firebase Auth UID of the submitting student."
        },
        "studentAccountId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Student app account ID."
        },
        "allowedTeacherUids": {
          "type": "array",
          "description": "Bounded list of up to 10 teacher UIDs allowed to list/read/review."
        },
        "title": {
          "type": "string",
          "maxLength": 200,
          "description": "LKPD title."
        },
        "groupName": {
          "type": "string",
          "maxLength": 120,
          "description": "Student group name."
        },
        "groupLeader": {
          "type": "string",
          "maxLength": 120,
          "description": "Group leader name."
        },
        "members": {
          "type": "string",
          "maxLength": 600,
          "description": "Group members list."
        },
        "className": {
          "type": "string",
          "maxLength": 60,
          "description": "Student class."
        },
        "school": {
          "type": "string",
          "maxLength": 150,
          "description": "School name."
        },
        "date": {
          "type": "string",
          "maxLength": 30,
          "description": "Submission date string."
        },
        "labMode": {
          "type": "string",
          "enum": ["GLB", "GLBB"],
          "description": "Active physics simulation mode."
        },
        "glbRows": {
          "type": "array",
          "description": "GLB experiment telemetry rows (max 50)."
        },
        "glbbAccelRows": {
          "type": "array",
          "description": "GLBB accelerated experiment rows (max 50)."
        },
        "glbbDecelRows": {
          "type": "array",
          "description": "GLBB decelerated experiment rows (max 50)."
        },
        "ans1": {
          "type": "string",
          "maxLength": 2000,
          "description": "Analysis question 1 answer."
        },
        "ans2": {
          "type": "string",
          "maxLength": 2000,
          "description": "Analysis question 2 answer."
        },
        "ans4": {
          "type": "string",
          "maxLength": 2000,
          "description": "Analysis question 3 answer."
        },
        "ans5": {
          "type": "string",
          "maxLength": 2000,
          "description": "Analysis question 4 answer."
        },
        "ans6": {
          "type": "string",
          "maxLength": 2000,
          "description": "Analysis question 5 answer."
        },
        "conclusion": {
          "type": "string",
          "maxLength": 2000,
          "description": "Practicum conclusion."
        },
        "status": {
          "type": "string",
          "enum": ["submitted", "finalized"],
          "description": "Submission lifecycle status."
        },
        "feedbackStatus": {
          "type": "string",
          "enum": ["pending", "reviewed"],
          "description": "Teacher feedback status."
        },
        "teacherFeedback": {
          "type": "string",
          "maxLength": 2000,
          "description": "Written feedback from teacher."
        },
        "feedbackBy": {
          "type": "string",
          "maxLength": 120,
          "description": "Name of teacher providing feedback."
        },
        "feedbackByUid": {
          "type": "string",
          "maxLength": 128,
          "description": "UID of teacher providing feedback."
        },
        "feedbackAt": {
          "type": "string",
          "maxLength": 64,
          "description": "ISO timestamp of teacher feedback."
        },
        "submittedAt": {
          "type": "string",
          "maxLength": 64,
          "description": "ISO timestamp of submission."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Creation server timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Last update server timestamp."
        }
      },
      "required": [
        "id",
        "npsn",
        "studentUid",
        "studentAccountId",
        "allowedTeacherUids",
        "title",
        "groupName",
        "groupLeader",
        "members",
        "className",
        "school",
        "date",
        "labMode",
        "glbRows",
        "glbbAccelRows",
        "glbbDecelRows",
        "ans1",
        "ans2",
        "ans4",
        "ans5",
        "ans6",
        "conclusion",
        "status",
        "feedbackStatus",
        "teacherFeedback",
        "feedbackBy",
        "feedbackByUid",
        "feedbackAt",
        "submittedAt",
        "createdAt",
        "updatedAt"
      ]
    },
    "QuizSubmission": {
      "title": "QuizSubmission",
      "description": "Student quiz attempt record synced to the teacher account via school NPSN.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Quiz result ID."
        },
        "npsn": {
          "type": "string",
          "minLength": 4,
          "maxLength": 20,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "School NPSN identifier."
        },
        "studentUid": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Firebase Auth UID of the student."
        },
        "studentAccountId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Student app account ID."
        },
        "studentName": {
          "type": "string",
          "maxLength": 120,
          "description": "Student display name."
        },
        "className": {
          "type": "string",
          "maxLength": 60,
          "description": "Student class."
        },
        "allowedTeacherUids": {
          "type": "array",
          "description": "Bounded list of up to 10 teacher UIDs."
        },
        "score": {
          "type": "number",
          "description": "Quiz score between 0 and 100."
        },
        "totalQuestions": {
          "type": "number",
          "description": "Total number of questions."
        },
        "timeSpentSeconds": {
          "type": "number",
          "description": "Time spent in seconds."
        },
        "category": {
          "type": "string",
          "maxLength": 80,
          "description": "Assessment category."
        },
        "submittedAt": {
          "type": "string",
          "maxLength": 64,
          "description": "ISO timestamp of completion."
        },
        "createdAt": {
          "type": "string",
